<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Gate Pass GE-20260818-155430</title>
    <style>
        body {
            font-family: 'Courier New', Courier, monospace;
            margin: 20px;
            color: #000;
            background: #fff;
            font-size: 12px;
            max-width: 400px;
            border: 1px dashed #ccc;
            padding: 20px;
        }
        .header {
            text-align: center;
            border-bottom: 1px solid #000;
            padding-bottom: 10px;
            margin-bottom: 15px;
        }
        .title {
            font-size: 18px;
            font-weight: bold;
            margin: 0;
            text-transform: uppercase;
        }
        .subtitle {
            font-size: 10px;
            margin-top: 4px;
        }
        .pass-number {
            font-size: 14px;
            font-weight: bold;
            margin: 10px 0;
            text-align: center;
        }
        .section-title {
            font-size: 12px;
            font-weight: bold;
            border-bottom: 1px solid #eee;
            margin-top: 15px;
            margin-bottom: 8px;
            text-transform: uppercase;
        }
        .field-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 4px;
        }
        .field-label {
            font-weight: normal;
            color: #333;
        }
        .field-val {
            font-weight: bold;
            text-align: right;
        }
        .footer {
            margin-top: 30px;
            padding-top: 10px;
            border-top: 1px solid #000;
            text-align: center;
            font-size: 10px;
        }
        .signature-box {
            margin-top: 40px;
            display: flex;
            justify-content: space-between;
        }
        .signature-line {
            border-top: 1px solid #000;
            width: 45%;
            padding-top: 5px;
            font-size: 9px;
            text-align: center;
        }
        @media print {
            body { border: none; margin: 0; padding: 10px; }
            .no-print { display: none; }
        }
    </style>
</head>
<body>
    <div class="header">
        <h1 class="title">GATE ENTRY PASS</h1>
        <div class="subtitle">WMS Logistics Management System</div>
    </div>

    <div class="pass-number">
        GE-20260818-155430
    </div>

    <div class="section-title">Vehicle & Driver</div>
    <div class="field-row">
        <span class="field-label">Vehicle Plate:</span>
        <span class="field-val">KA13V5848</span>
    </div>
    <div class="field-row">
        <span class="field-label">Entry Date/Time:</span>
        <span class="field-val">18-08-2026 07:26:16</span>
    </div>

    <div class="section-title">Shipment Details</div>
    <div class="field-row">
        <span class="field-label">PO Number:</span>
        <span class="field-val">PO-2026-0001</span>
    </div>
    <div class="field-row">
        <span class="field-label">Supplier:</span>
        <span class="field-val">MTR</span>
    </div>
    <div class="field-row">
        <span class="field-label">Material:</span>
        <span class="field-val">plastic</span>
    </div>
    <div class="field-row">
        <span class="field-label">Total Qty:</span>
        <span class="field-val">15.00</span>
    </div>

    <div class="section-title">Status</div>
    <div class="field-row">
        <span class="field-label">Entry Status:</span>
        <span class="field-val">Unscheduled Arrival</span>
    </div>
    <div class="field-row">
        <span class="field-label">Generated By:</span>
        <span class="field-val">localdev</span>
    </div>

    <div class="signature-box">
        <div class="signature-line">Driver Signature</div>
        <div class="signature-line">Security Officer</div>
    </div>

    <div class="footer">
        Valid for one-time entry only.
        <br>Keep this pass until exit from premises.
    </div>

    <div class="no-print" style="margin-top: 20px; text-align: center;">
        <button onclick="window.print()" style="padding: 8px 16px; cursor: pointer;">Print Pass</button>
    </div>
</body>
</html>
